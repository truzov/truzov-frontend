# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright run output: traces, screenshots and videos of the last run. Regenerated on every
# `playwright test`, machine-specific, and large — it is a build artefact, not a deliverable.
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.kiro/
/.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. Real ones hold machine- and environment-specific values and stay local.
.env*

# ...but the *.example templates are documentation, not configuration: they are how a new
# contributor (and Vercel) learns which variables exist. These negations must come after the
# broad `.env*` above, because for gitignore the last matching pattern wins.
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
