# Copy this file to .env.local and adjust for your environment.
#
#   cp .env.local.example .env.local
#
# Only NEXT_PUBLIC_* values belong in this file. Next.js inlines them into the browser bundle,
# so they are public by definition. Never put a secret, API key, or token here.

# ---------------------------------------------------------------------------------------------
# Backend origin. ORIGIN ONLY — no trailing slash, no /api/v1 suffix.
#
# The frontend appends /api/v1 itself (lib/config/env.ts), so this is just scheme + host + port.
#   local backend:  http://localhost:8080
#   Render:         https://truzov-backend.onrender.com
#
# Leave it unset in local dev and it falls back to http://localhost:8080. A *production* build
# with this unset fails on purpose, rather than shipping a bundle that points visitors'
# browsers at their own localhost.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------------------------
# Public site origin, used for metadataBase (absolute URLs in OG/canonical tags).
# Defaults to https://truzov.com when unset. On Vercel, set it to the deployment URL.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------------------------
# Google OAuth 2.0 client id, from the Google Cloud console (APIs & Services > Credentials >
# OAuth client ID > Web application). OPTIONAL: leave it unset and the "Continue with Google"
# button is not rendered at all, which mirrors the backend treating absent credentials as a
# valid configuration rather than a broken one.
#
# Only the client id belongs here. The client SECRET must never reach the frontend — the
# browser obtains an authorization code and the backend redeems it, which is the entire reason
# the flow is shaped this way.
#
# Three values must agree or Google rejects the exchange with `invalid_grant`:
#   1. this client id
#   2. the "Authorised redirect URI" registered in the console
#   3. the backend's TRUZOV_GOOGLE_REDIRECT_URI
# For local development that URI is http://localhost:3000/auth/google/callback, the route at
# app/auth/google/callback. The frontend derives it from window.location.origin, so it follows
# whatever port the dev server actually runs on.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnop.apps.googleusercontent.com
